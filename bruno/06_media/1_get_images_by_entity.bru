meta {
  name: Get Images by Entity
  type: graphql
  seq: 1
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query GetImagesByEntity($entityId: ID!, $entityType: ImageEntityType!, $limit: Int, $offset: Int) {
    imagesByEntity(entityId: $entityId, entityType: $entityType, limit: $limit, offset: $offset) {
      id
      fileName
      originalName
      mimeType
      size
      url
      entityType
      entityId
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "entityId": "{{PRODUCT_ID}}",
    "entityType": "product",
    "limit": 20,
    "offset": 0
  }
}

docs {
  List images for an entity (product, user, category) with pagination. Requires management access or owner (for entityType=user). Schema: apps/media-service/src/graphql/schema.ts:Query.imagesByEntity
}
