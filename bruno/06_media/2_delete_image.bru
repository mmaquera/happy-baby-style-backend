meta {
  name: Delete Image [ADMIN]
  type: graphql
  seq: 2
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeleteImage($id: ID!) {
    deleteImage(id: $id)
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_IMAGE_ID"
  }
}

docs {
  Delete an image record. Requires management access or owner (for entityType=user). Returns Boolean. Schema: apps/media-service/src/graphql/schema.ts:Mutation.deleteImage
}
