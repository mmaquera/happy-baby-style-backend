meta {
  name: Get Category by Slug
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}
}

body:graphql {
  query GetCategoryBySlug($slug: String!) {
    categoryBySlug(slug: $slug) {
      success
      code
      message
      data {
        id
        name
        description
        slug
        image
        isActive
        sortOrder
      }
    }
  }
}

body:graphql:vars {
  {
    "slug": "ropa-bebe"
  }
}
