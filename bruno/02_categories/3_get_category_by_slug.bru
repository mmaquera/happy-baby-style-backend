meta {
  name: Get Category by Slug
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}
}

body:graphql {
  query GetCategoryBySlug($slug: String!) {
    categoryBySlug(slug: $slug) {
      success
      code
      message
      data {
        id
        name
        description
        slug
        image
        isActive
        sortOrder
        parentCategoryId
        parent {
          id
          name
          slug
        }
        children {
          id
          name
          slug
          isActive
          sortOrder
        }
        createdAt
        updatedAt
      }
    }
  }
}

body:graphql:vars {
  {
    "slug": "ropa-bebe"
  }
}
