meta {
  name: Delete Category [ADMIN]
  type: graphql
  seq: 6
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeleteCategory($id: ID!) {
    deleteCategory(id: $id) {
      success
      code
      message
      data {
        id
        deletedAt
        softDelete
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "{{CATEGORY_ID}}"
  }
}

docs {
  Delete a product category (soft-delete). Requires system management access (administrators group, or permission: manage:system). Schema: apps/category-service/src/graphql/schema.ts:Mutation.deleteCategory
}
