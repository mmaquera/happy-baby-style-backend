meta {
  name: List Categories
  type: graphql
  seq: 1
}

post {
  url: {{BASE_URL}}
}

body:graphql {
  query ListCategories($filters: CategoryFilterInput, $pagination: PaginationInput) {
    categories(filters: $filters, pagination: $pagination) {
      success
      code
      message
      data {
        items {
          id
          name
          description
          slug
          image
          isActive
          sortOrder
          parentCategoryId
          parent {
            id
            name
            slug
          }
          children {
            id
            name
            slug
            isActive
          }
          createdAt
          updatedAt
        }
        pagination {
          total
          limit
          offset
          hasMore
          currentPage
          totalPages
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "filters": { "isActive": true },
    "pagination": { "limit": 20, "offset": 0 }
  }
}
