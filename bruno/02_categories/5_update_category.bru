meta {
  name: Update Category [ADMIN]
  type: graphql
  seq: 5
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation UpdateCategory($id: ID!, $input: UpdateCategoryInput!) {
    updateCategory(id: $id, input: $input) {
      success
      code
      message
      data {
        id
        updatedAt
        changes
        entity {
          id
          name
          slug
          isActive
          sortOrder
          parentCategoryId
          parent {
            id
            name
            slug
          }
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "{{CATEGORY_ID}}",
    "input": {
      "description": "Ropa y accesorios para bebés de 0 a 24 meses",
      "isActive": true
    }
  }
}

docs {
  Update a product category. Requires system management access (administrators group, or permission: manage:system). Schema: apps/category-service/src/graphql/schema.ts:Mutation.updateCategory
}
