meta {
  name: Delete Product [ADMIN]
  type: graphql
  seq: 10
}

post {
  url: {{BASE_URL}}
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeleteProduct($id: ID!) {
    deleteProduct(id: $id) {
      success
      code
      message
      data {
        id
        deletedAt
        softDelete
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "{{PRODUCT_ID}}"
  }
}
