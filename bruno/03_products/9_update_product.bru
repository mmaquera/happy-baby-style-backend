meta {
  name: Update Product [ADMIN]
  type: graphql
  seq: 9
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation UpdateProduct($id: ID!, $input: UpdateProductInput!) {
    updateProduct(id: $id, input: $input) {
      success
      code
      message
      data {
        id
        updatedAt
        changes
        entity {
          id
          name
          price
          salePrice
          stockQuantity
          isActive
          taxAffectation
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "{{PRODUCT_ID}}",
    "input": {
      "salePrice": 38000,
      "stockQuantity": 45,
      "taxAffectation": "exonerado"
    }
  }
}

docs {
  Updates a product — demonstrates changing taxAffectation from gravado to exonerado. Requires products:write permission (inventory-user, administrators). Schema: apps/product-service/src/graphql/schema.ts:Mutation.updateProduct
}
