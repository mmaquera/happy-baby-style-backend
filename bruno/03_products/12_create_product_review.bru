meta {
  name: Create Product Review
  type: graphql
  seq: 12
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation CreateProductReview($input: CreateProductReviewInput!) {
    createProductReview(input: $input) {
      id
      productId
      userId
      rating
      title
      comment
      isVerified
      isApproved
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "productId": "{{PRODUCT_ID}}",
      "rating": 5,
      "title": "Excelente calidad",
      "comment": "El mameluco es muy suave y de buena calidad. Mi bebé lo ama."
    }
  }
}

docs {
  Create a product review. userId is derived from the JWT — do NOT pass it in input (BOLA fix). Requires any authenticated user. Schema: apps/product-service/src/graphql/schema.ts:Mutation.createProductReview
}
