meta {
  name: Create Inventory Transaction [ADMIN]
  type: graphql
  seq: 13
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation CreateInventoryTransaction($input: CreateInventoryTransactionInput!) {
    createInventoryTransaction(input: $input) {
      id
      productId
      type
      quantity
      reference
      notes
      createdAt
    }
  }
}

docs {
  Record an inventory movement (purchase, sale, return, adjustment, transfer). Returns raw InventoryTransaction (no wrapper). Requires inventory management access. Permission: create:product. Schema: apps/product-service/src/graphql/schema.ts:Mutation.createInventoryTransaction
}

body:graphql:vars {
  {
    "input": {
      "productId": "{{PRODUCT_ID}}",
      "type": "purchase",
      "quantity": 100,
      "reference": "OC-2024-001",
      "notes": "Reposición de inventario inicial"
    }
  }
}
