meta {
  name: Create Product Variant [ADMIN]
  type: graphql
  seq: 11
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation CreateProductVariant($input: CreateProductVariantInput!) {
    createProductVariant(input: $input) {
      id
      productId
      name
      price
      sku
      stockQuantity
      isActive
      isInStock
      createdAt
    }
  }
}

docs {
  Create a product variant. Returns raw ProductVariant (no wrapper). Requires inventory management access (inventory-user, administrators). Permission: create:product. Schema: apps/product-service/src/graphql/schema.ts:Mutation.createProductVariant
}

body:graphql:vars {
  {
    "input": {
      "productId": "{{PRODUCT_ID}}",
      "name": "Talla 0-3 meses / Azul",
      "price": 45000,
      "sku": "MAM-EST-001-0-3M-AZ",
      "stockQuantity": 15,
      "isActive": true,
      "attributes": { "size": "0-3M", "color": "azul" }
    }
  }
}
