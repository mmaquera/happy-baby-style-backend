meta {
  name: Approve Review [ADMIN]
  type: graphql
  seq: 16
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation ApproveReview($id: ID!) {
    approveReview(id: $id) {
      id
      productId
      userId
      rating
      status
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_REVIEW_ID"
  }
}

docs {
  Transition a review to approved status (state machine: pending → approved). Requires reviews:moderate permission. Use ACCESS_TOKEN minted for a user in the customer-service or administrators group. Schema: apps/product-service/src/graphql/schema.ts:Mutation.approveReview
}
