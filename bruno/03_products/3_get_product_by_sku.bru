meta {
  name: Get Product by SKU
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}
}

body:graphql {
  query GetProductBySku($sku: String!) {
    productBySku(sku: $sku) {
      success
      code
      message
      data {
        entity {
          id
          name
          price
          sku
          stockQuantity
          isActive
          isInStock
          currentPrice
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "sku": "PROD-001"
  }
}
