meta {
  name: Refresh Token
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: none
}

body:graphql {
  mutation RefreshToken($refreshToken: String!) {
    refreshToken(refreshToken: $refreshToken) {
      success
      code
      message
      data {
        accessToken
        refreshToken
        user {
          id
          email
          role
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "refreshToken": "{{REFRESH_TOKEN}}"
  }
}

script:post-response {
  const data = res.body?.data?.refreshToken?.data;
  if (res.status === 200 && data?.accessToken) {
    bru.setEnvVar("ACCESS_TOKEN", data.accessToken);
    bru.setEnvVar("REFRESH_TOKEN", data.refreshToken);
  }
}

docs {
  Exchanges a valid REFRESH_TOKEN for a new access/refresh pair. Captures both tokens on success.
  Schema: apps/user-service/src/graphql/schema.ts:Mutation.refreshToken
}
