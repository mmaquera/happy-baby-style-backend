meta {
  name: Reset Password
  type: graphql
  seq: 6
}

post {
  url: {{BASE_URL}}
}

body:graphql {
  mutation ResetPassword($token: String!, $newPassword: String!) {
    resetPassword(token: $token, newPassword: $newPassword) {
      success
      code
      message
      data {
        timestamp
        passwordUpdated
      }
    }
  }
}

body:graphql:vars {
  {
    "token": "<paste-reset-token-from-email>",
    "newPassword": "NewPassword1234!"
  }
}
