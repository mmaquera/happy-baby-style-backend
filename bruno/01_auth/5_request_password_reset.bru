meta {
  name: Request Password Reset
  type: graphql
  seq: 5
}

post {
  url: {{BASE_URL}}
}

body:graphql {
  mutation RequestPasswordReset($email: String!) {
    requestPasswordReset(email: $email) {
      success
      code
      message
      data {
        email
        timestamp
      }
    }
  }
}

body:graphql:vars {
  {
    "email": "user@example.com"
  }
}
