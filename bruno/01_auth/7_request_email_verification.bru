meta {
  name: Request Email Verification
  type: graphql
  seq: 7
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: none
}

body:graphql {
  mutation RequestEmailVerification($email: String!) {
    requestEmailVerification(email: $email) {
      success
      code
      message
      data {
        email
        timestamp
      }
    }
  }
}

body:graphql:vars {
  {
    "email": "marco.arka@gmail.com"
  }
}

docs {
  Requests a new email verification token; sends a verification link to the given address. Schema: apps/user-service/src/graphql/schema.ts:Mutation.requestEmailVerification
}
