meta {
  name: Login
  type: graphql
  seq: 2
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: none
}

body:graphql {
  mutation Login($email: String!, $password: String!) {
    loginUser(email: $email, password: $password) {
      success
      code
      message
      data {
        accessToken
        refreshToken
        mfaRequired
        mfaChallengeToken
        user {
          id
          email
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "email": "marco.arka@gmail.com",
    "password": "Admin123!"
  }
}

script:post-response {
  const data = res.body?.data?.loginUser?.data;
  if (res.status === 200 && data) {
    if (data.accessToken) {
      bru.setEnvVar("ACCESS_TOKEN", data.accessToken);
      bru.setEnvVar("REFRESH_TOKEN", data.refreshToken);
      bru.setEnvVar("USER_ID", data.user.id);
    }
    if (data.mfaRequired && data.mfaChallengeToken) {
      bru.setEnvVar("MFA_CHALLENGE_TOKEN", data.mfaChallengeToken);
    }
  }
}

docs {
  Happy path login. On success captures ACCESS_TOKEN, REFRESH_TOKEN, USER_ID.
  When mfaRequired=true captures MFA_CHALLENGE_TOKEN for step-2 in Verify TOTP.
  Error on bad credentials: { success: false, message: "Invalid email or password" }.
  Schema: apps/user-service/src/graphql/schema.ts:Mutation.loginUser
}
