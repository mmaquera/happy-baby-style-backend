meta {
  name: Verify Email
  type: graphql
  seq: 8
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: none
}

body:graphql {
  mutation VerifyEmail($token: String!) {
    verifyEmail(token: $token) {
      success
      code
      message
      data {
        emailVerified
        timestamp
      }
    }
  }
}

body:graphql:vars {
  {
    "token": "REPLACE_ME_VERIFICATION_TOKEN"
  }
}

docs {
  Confirms email ownership by consuming the one-time verification token sent by requestEmailVerification. Schema: apps/user-service/src/graphql/schema.ts:Mutation.verifyEmail
}
