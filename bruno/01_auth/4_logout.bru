meta {
  name: Logout
  type: graphql
  seq: 4
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation Logout {
    logoutUser {
      success
      message
    }
  }
}

body:graphql:vars {
  {}
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("ACCESS_TOKEN", "");
    bru.setEnvVar("REFRESH_TOKEN", "");
  }
}

docs {
  Invalidates the current session. Clears ACCESS_TOKEN and REFRESH_TOKEN env vars on success.
  Schema: apps/user-service/src/graphql/schema.ts:Mutation.logoutUser
}
