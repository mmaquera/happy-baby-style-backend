meta {
  name: Register User
  type: graphql
  seq: 1
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: none
}

body:graphql {
  mutation RegisterUser($input: CreateUserProfileInput!) {
    registerUser(input: $input) {
      success
      code
      message
      data {
        accessToken
        refreshToken
        mfaRequired
        mfaChallengeToken
        user {
          id
          email
          role
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "marco.arka@gmail.com",
      "password": "Admin123!",
      "firstName": "Marco",
      "lastName": "Maquera"
    }
  }
}

script:post-response {
  const data = res.body?.data?.registerUser?.data;
  if (res.status === 200 && data?.accessToken) {
    bru.setEnvVar("ACCESS_TOKEN", data.accessToken);
    bru.setEnvVar("REFRESH_TOKEN", data.refreshToken);
    bru.setEnvVar("USER_ID", data.user.id);
  }
}

docs {
  Registers a new user and returns a full AuthResponse (same shape as loginUser).
  On success captures ACCESS_TOKEN, REFRESH_TOKEN, USER_ID.
  Schema: apps/user-service/src/graphql/schema.ts:Mutation.registerUser
}
