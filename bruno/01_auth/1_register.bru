meta {
  name: Register User
  type: graphql
  seq: 1
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: none
}

body:graphql {
  mutation RegisterUser($input: CreateUserProfileInput!) {
    registerUser(input: $input) {
      success
      code
      message
      data {
        accessToken
        refreshToken
        user {
          id
          email
          role
        }
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "marco.arka@gmail.com",
      "password": "Admin123!",
      "firstName": "Marco",
      "lastName": "Maquera"
    }
  }
}
