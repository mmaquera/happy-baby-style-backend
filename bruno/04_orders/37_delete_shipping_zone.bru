meta {
  name: Delete Shipping Zone [ADMIN]
  type: graphql
  seq: 37
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeleteShippingZone($id: ID!) {
    deleteShippingZone(id: $id) {
      success
      message
    }
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_ZONE_ID"
  }
}

docs {
  Delete a shipping zone by ID. Returns SuccessResponse — a non-existent ID returns { success: true } (anti-enumeration). Requires administrators group. Permission: manage:system. Schema: apps/order-service/src/graphql/schema.ts:Mutation.deleteShippingZone
}
