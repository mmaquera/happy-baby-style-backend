meta {
  name: Delete Delivery Slot [ADMIN]
  type: graphql
  seq: 43
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeleteDeliverySlot($id: ID!) {
    deleteDeliverySlot(id: $id) {
      success
      message
    }
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_SLOT_ID"
  }
}

docs {
  Delete a delivery slot by ID. Returns SuccessResponse — a non-existent ID returns { success: true } (anti-enumeration). Requires administrators group. Permission: manage:system. Schema: apps/order-service/src/graphql/schema.ts:Mutation.deleteDeliverySlot
}
