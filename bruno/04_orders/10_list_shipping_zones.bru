meta {
  name: List Shipping Zones
  type: graphql
  seq: 10
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query ListShippingZones {
    shippingZones {
      id
      name
      countries
      states
      cities
      postalCodes
      isActive
      createdAt
      updatedAt
    }
  }
}

docs {
  List all shipping zones. Requires management access (administrators, sales-manager). Permission: orders:read. Schema: apps/order-service/src/graphql/schema.ts:Query.shippingZones
}
