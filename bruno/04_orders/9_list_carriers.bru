meta {
  name: List Carriers
  type: graphql
  seq: 9
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query ListCarriers {
    carriers {
      id
      name
      code
      trackingUrlTemplate
      isActive
      createdAt
      updatedAt
    }
  }
}

docs {
  List all shipping carriers. Requires management access (administrators, sales-manager). Permission: orders:read. Schema: apps/order-service/src/graphql/schema.ts:Query.carriers
}
