meta {
  name: List Orders [ADMIN]
  type: graphql
  seq: 2
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query ListOrders($filter: OrderFilterInput, $pagination: PaginationInput) {
    orders(filter: $filter, pagination: $pagination) {
      orders {
        id
        orderNumber
        customerEmail
        customerName
        status
        totalAmount
        currency
        createdAt
      }
      total
      hasMore
    }
  }
}

body:graphql:vars {
  {
    "filter": {},
    "pagination": { "limit": 20, "offset": 0 }
  }
}

docs {
  Paginated order list for the admin dashboard. Requires management access (sales-manager, administrators). Permission: orders:read. Schema: apps/order-service/src/graphql/schema.ts:Query.orders
}
