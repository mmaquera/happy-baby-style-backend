meta {
  name: Get Coupon by Code
  type: graphql
  seq: 7
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query GetCouponByCode($code: String!) {
    couponByCode(code: $code) {
      id
      code
      name
      discountType
      discountValue
      minimumAmount
      maximumDiscount
      validFrom
      validUntil
      isActive
      usageLimit
      usedCount
    }
  }
}

body:graphql:vars {
  {
    "code": "{{COUPON_CODE}}"
  }
}

docs {
  Fetch a coupon by code. Requires auth (any authenticated user for checkout validation) or management access for admin queries. Schema: apps/order-service/src/graphql/schema.ts:Query.couponByCode
}
