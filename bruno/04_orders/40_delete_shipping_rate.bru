meta {
  name: Delete Shipping Rate [ADMIN]
  type: graphql
  seq: 40
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeleteShippingRate($id: ID!) {
    deleteShippingRate(id: $id) {
      success
      message
    }
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_RATE_ID"
  }
}

docs {
  Delete a shipping rate by ID. Returns SuccessResponse — a non-existent ID returns { success: true } (anti-enumeration). Requires administrators group. Permission: manage:system. Schema: apps/order-service/src/graphql/schema.ts:Mutation.deleteShippingRate
}
