meta {
  name: Create Coupon [ADMIN]
  type: graphql
  seq: 8
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation CreateCoupon($input: CreateCouponInput!) {
    createCoupon(input: $input) {
      id
      code
      name
      discountType
      discountValue
      minimumAmount
      maximumDiscount
      usageLimit
      usedCount
      validFrom
      validUntil
      isActive
      isFirstTimeOnly
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "code": "WELCOME10",
      "name": "Bienvenida 10%",
      "description": "10% de descuento en tu primera compra",
      "discountType": "percentage",
      "discountValue": 10,
      "minimumAmount": 50000,
      "usageLimit": 500,
      "validFrom": "2024-01-01T00:00:00Z",
      "validUntil": "2025-12-31T23:59:59Z",
      "isActive": true,
      "isFirstTimeOnly": true
    }
  }
}

docs {
  Create a new discount coupon. Requires administrators or sales-manager group. Permission: manage:system. Schema: apps/order-service/src/graphql/schema.ts:Mutation.createCoupon
}
