meta {
  name: Order Stats [ADMIN]
  type: graphql
  seq: 4
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query OrderStats {
    orderStats {
      totalOrders
      pendingOrders
      processingOrders
      shippedOrders
      deliveredOrders
      cancelledOrders
      totalRevenue
      averageOrderValue
      todayOrders
      todayRevenue
      activeCoupons
    }
  }
}

docs {
  Aggregate order statistics for the store dashboard. Requires management access (sales-manager, administrators). Permission: orders:read. Schema: apps/order-service/src/graphql/schema.ts:Query.orderStats
}
