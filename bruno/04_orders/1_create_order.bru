meta {
  name: Create Order
  type: graphql
  seq: 1
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation CreateOrder($input: CreateOrderInput!) {
    createOrder(input: $input) {
      id
      orderNumber
      customerEmail
      customerName
      status
      subtotal
      taxAmount
      shippingAmount
      discountAmount
      totalAmount
      currency
      billingDocumentType
      billingDocumentNumber
      billingLegalName
      billingFirstName
      billingLastName
      billingAddressId
      taxableAmount
      exemptAmount
      nonTaxableAmount
      igvAmount
      createdAt
      items {
        id
        productId
        quantity
        price
        taxAffectation
        igvBase
        igvAmount
      }
      shippingAddress {
        id
        street
        city
        state
        zipCode
        country
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "customerName": "Empresa Comercial SAC",
      "customerPhone": "+51 1 234 5678",
      "items": [
        {
          "productId": "{{PRODUCT_ID}}",
          "quantity": 2,
          "size": "0-3M",
          "color": "azul"
        }
      ],
      "shippingAddress": {
        "street": "Av. Javier Prado Este 4200",
        "city": "Lima",
        "state": "Lima",
        "zipCode": "15023",
        "country": "PE"
      },
      "billingData": {
        "documentType": "ruc",
        "documentNumber": "20100070970",
        "legalName": "Empresa Comercial SAC"
      }
    }
  }
}

script:post-response {
  const id = res.body?.data?.createOrder?.id;
  if (id) {
    bru.setEnvVar("ORDER_ID", id);
  }
}

docs {
  Creates an order with RUC billing data. IGV breakdown (taxableAmount, exemptAmount, nonTaxableAmount, igvAmount) is calculated server-side from each product's taxAffectation — do NOT pass taxAffectation in CreateOrderItemInput (anti-manipulation). Price is IGV-inclusive for gravado lines; igvRate sourced from StoreSettings. Schema: apps/order-service/src/graphql/schema.ts:Mutation.createOrder
}
