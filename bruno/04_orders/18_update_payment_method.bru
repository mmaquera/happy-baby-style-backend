meta {
  name: Update Payment Method [MGMT]
  type: graphql
  seq: 18
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation UpdatePaymentMethod($id: ID!, $input: UpdatePaymentMethodInput!) {
    updatePaymentMethod(id: $id, input: $input) {
      id
      orderId
      type
      amount
      status
      transactionId
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_PAYMENT_METHOD_ID",
    "input": {
      "status": "completed",
      "transactionId": "TXN-2026-001-CONFIRMED"
    }
  }
}

docs {
  Update a payment method record. Requires management access or ownership of the parent order. Permission: orders:write. Schema: apps/order-service/src/graphql/schema.ts:Mutation.updatePaymentMethod
}
