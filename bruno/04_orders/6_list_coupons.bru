meta {
  name: List Coupons [ADMIN]
  type: graphql
  seq: 6
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query ListCoupons {
    coupons {
      id
      code
      name
      description
      discountType
      discountValue
      minimumAmount
      usageLimit
      usedCount
      validFrom
      validUntil
      isActive
      isFirstTimeOnly
      createdAt
    }
  }
}

docs {
  Full coupon catalogue. Requires management access (sales-manager, administrators). Use activeCoupons for the public storefront list. Schema: apps/order-service/src/graphql/schema.ts:Query.coupons
}
