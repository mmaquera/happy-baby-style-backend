meta {
  name: Update Order Status [ADMIN]
  type: graphql
  seq: 5
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation UpdateOrderStatus($id: ID!, $status: OrderStatus!) {
    updateOrderStatus(id: $id, status: $status) {
      id
      orderNumber
      status
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{ORDER_ID}}",
    "status": "confirmed"
  }
}

docs {
  Update the status of a single order. Requires owner (order.userId = JWT sub) or management access (sales-manager, administrators). Permission: orders:write. Schema: apps/order-service/src/graphql/schema.ts:Mutation.updateOrderStatus
}
