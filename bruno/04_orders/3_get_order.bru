meta {
  name: Get Order by ID
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query GetOrder($id: ID!) {
    order(id: $id) {
      id
      orderNumber
      customerEmail
      customerName
      status
      subtotal
      taxAmount
      shippingAmount
      discountAmount
      totalAmount
      currency
      notes
      createdAt
      updatedAt
      deliveredAt
      items {
        id
        productId
        quantity
        price
      }
      shippingAddress {
        id
        street
        city
        state
        zipCode
        country
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "{{ORDER_ID}}"
  }
}

docs {
  Fetch a single order. Requires owner (order.userId = JWT sub) or management access (sales-manager, customer-service). Permission: orders:read. Schema: apps/order-service/src/graphql/schema.ts:Query.order
}
