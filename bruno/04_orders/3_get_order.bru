meta {
  name: Get Order by ID
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:graphql {
  query GetOrder($id: ID!) {
    order(id: $id) {
      id
      orderNumber
      customerEmail
      customerName
      status
      subtotal
      taxAmount
      shippingAmount
      discountAmount
      totalAmount
      currency
      notes
      createdAt
      updatedAt
      deliveredAt
      items {
        id
        productId
        quantity
        price
      }
      shippingAddress {
        id
        street
        city
        state
        zipCode
        country
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "{{ORDER_ID}}"
  }
}
