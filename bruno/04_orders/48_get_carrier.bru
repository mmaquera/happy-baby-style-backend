meta {
  name: Get Carrier by ID
  type: graphql
  seq: 48
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query GetCarrier($id: ID!) {
    carrier(id: $id) {
      id
      name
      code
      trackingUrlTemplate
      isActive
      createdAt
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_CARRIER_ID"
  }
}

docs {
  Fetch a single carrier by UUID. Requires management access (administrators, sales-manager). Permission: orders:read. Schema: apps/order-service/src/graphql/schema.ts:Query.carrier
}
