meta {
  name: Clear User Cart
  type: graphql
  seq: 13
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation ClearUserCart {
    clearUserCart {
      success
      message
    }
  }
}

docs {
  Clears the authenticated user's cart. userId is derived from the JWT — no args accepted (BOLA fix). Requires any authenticated user. Schema: apps/order-service/src/graphql/schema.ts:Mutation.clearUserCart
}
