meta {
  name: Get User Cart
  type: graphql
  seq: 12
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  query GetUserCart($userId: ID!) {
    userCart(userId: $userId) {
      id
      userId
      createdAt
      updatedAt
      items {
        id
        productId
        quantity
        price
        createdAt
      }
    }
  }
}

body:graphql:vars {
  {
    "userId": "{{USER_ID}}"
  }
}

docs {
  Returns the cart for a given user. Requires owner (userId = JWT sub) or management access (sales-manager, customer-service). Permission: orders:read or owner. Schema: apps/order-service/src/graphql/schema.ts:Query.userCart
}
