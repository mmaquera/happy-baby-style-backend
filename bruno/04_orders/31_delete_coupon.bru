meta {
  name: Delete Coupon [ADMIN]
  type: graphql
  seq: 31
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeleteCoupon($id: ID!) {
    deleteCoupon(id: $id) {
      success
      message
    }
  }
}

body:graphql:vars {
  {
    "id": "REPLACE_ME_COUPON_ID"
  }
}

docs {
  Delete a coupon by ID. Returns SuccessResponse — a non-existent ID returns { success: true } (anti-enumeration). Requires administrators or sales-manager group. Permission: manage:system. Schema: apps/order-service/src/graphql/schema.ts:Mutation.deleteCoupon
}
