meta {
  name: Add to Cart
  type: graphql
  seq: 11
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation AddToCart($productId: ID!, $quantity: Int!) {
    addToCart(productId: $productId, quantity: $quantity) {
      id
      cartId
      productId
      quantity
      price
      createdAt
    }
  }
}

body:graphql:vars {
  {
    "productId": "{{PRODUCT_ID}}",
    "quantity": 1
  }
}

docs {
  Adds a product to the authenticated user's cart. userId is derived from the JWT — do NOT pass it as input (BOLA fix). Requires any authenticated user. Schema: apps/order-service/src/graphql/schema.ts:Mutation.addToCart
}
