meta {
  name: RBAC - Revoke Permission from Group [ADMIN]
  type: graphql
  seq: 29
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation RevokePermissionFromGroup($groupId: ID!, $permissionId: ID!) {
    revokePermissionFromGroup(groupId: $groupId, permissionId: $permissionId) {
      success
      message
    }
  }
}

body:graphql:vars {
  {
    "groupId": "REPLACE_ME_GROUP_ID",
    "permissionId": "REPLACE_ME_PERMISSION_ID"
  }
}

docs {
  Remove a permission link from a RBAC group. Requires administrators group. Schema: apps/user-service/src/graphql/schema.ts:Mutation.revokePermissionFromGroup
}
