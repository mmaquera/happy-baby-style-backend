meta {
  name: Get User by ID
  type: graphql
  seq: 3
}

post {
  url: {{BASE_URL}}
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:graphql {
  query GetUser($id: ID!) {
    user(id: $id) {
      id
      email
      isActive
      emailVerified
      lastLoginAt
      createdAt
      updatedAt
      profile {
        id
        firstName
        lastName
        phone
        avatar
        fullName
      }
      addresses {
        id
        type
        address1
        city
        state
        country
        isDefault
      }
    }
  }
}

body:graphql:vars {
  {
    "id": "{{USER_ID}}"
  }
}
