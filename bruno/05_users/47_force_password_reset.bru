meta {
  name: Force Password Reset [ADMIN]
  type: graphql
  seq: 47
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation ForcePasswordReset($userId: ID!) {
    forcePasswordReset(userId: $userId) {
      success
      message
    }
  }
}

body:graphql:vars {
  {
    "userId": "{{USER_ID}}"
  }
}

docs {
  Forces a password reset for the target user. Guard: requireAdministrator — administrators group required.
  On next login the user will receive forcePasswordReset=true in the AuthResponse and cannot obtain tokens until they change their password.
  ACCESS_TOKEN must belong to a user in the administrators group. Use admin login to mint this token.
  Schema: apps/user-service/src/graphql/schema.ts:Mutation.forcePasswordReset
}
