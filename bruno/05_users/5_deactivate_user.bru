meta {
  name: Deactivate User [ADMIN]
  type: graphql
  seq: 5
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation DeactivateUser($id: ID!) {
    deactivateUser(id: $id) {
      id
      email
      isActive
      updatedAt
    }
  }
}

body:graphql:vars {
  {
    "id": "{{USER_ID}}"
  }
}

docs {
  Deactivate a user account. Requires user management access (administrators, customer-service). Permission: users:write. Schema: apps/user-service/src/graphql/schema.ts:Mutation.deactivateUser
}
