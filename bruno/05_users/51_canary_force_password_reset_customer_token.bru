meta {
  name: Force Password Reset (Customer Token - Error Canary)
  type: graphql
  seq: 51
}

post {
  url: {{BASE_URL}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{ACCESS_TOKEN}}
}

body:graphql {
  mutation ForcePasswordResetCustomerToken($userId: ID!) {
    forcePasswordReset(userId: $userId) {
      success
      message
    }
  }
}

body:graphql:vars {
  {
    "userId": "00000000-0000-0000-0000-000000000002"
  }
}

docs {
  Regression canary: forcePasswordReset called with a customer-group token (not administrators).
  ACCESS_TOKEN must belong to a user in the customer group only — NOT administrators.
  Expected: GraphQL error with code FORBIDDEN — "Insufficient privileges — administrators group required".
  Guard under test: requireAdministrator(context.currentUser) in resolver.
  Schema: apps/user-service/src/graphql/schema.ts:Mutation.forcePasswordReset
}
