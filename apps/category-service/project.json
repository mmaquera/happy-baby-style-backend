{
  "name": "category-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/category-service/src",
  "implicitDependencies": [
    "logging",
    "prisma",
    "shared-kernel"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "rm -rf apps/category-service/dist && tsc -p apps/category-service/tsconfig.json"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/category-service/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node-dev --respawn --transpile-only apps/category-service/src/index.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/category-service/tsconfig.json"
        }
      }
    },
    "lint": {}
  }
}
