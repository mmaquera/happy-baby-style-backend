{
  "name": "user-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/user-service/src",
  "projectType": "application",
  "implicitDependencies": [
    "logging",
    "prisma",
    "shared-kernel",
    "auth"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf apps/user-service/dist && tsc -p apps/user-service/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/user-service/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/user-service/jest.config.js"
      }
    },
    "lint": {},
    "migrate-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --schema apps/user-service/prisma/schema.prisma"
      }
    },
    "migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --schema apps/user-service/prisma/schema.prisma"
      }
    },
    "migrate-status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate status --schema apps/user-service/prisma/schema.prisma"
      }
    }
  }
}
