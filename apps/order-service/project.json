{
  "name": "order-service",
  "projectType": "application",
  "sourceRoot": "apps/order-service/src",
  "implicitDependencies": [
    "logging",
    "prisma",
    "shared-kernel",
    "auth"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "rm -rf apps/order-service/dist && tsc -p apps/order-service/tsconfig.json"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/order-service/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node-dev --respawn --transpile-only apps/order-service/src/index.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/order-service/tsconfig.json"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config apps/order-service/jest.config.js"
      }
    },
    "lint": {}
  }
}
