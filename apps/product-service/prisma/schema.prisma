generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String          @id @default(uuid())
  categoryId      String          @map("category_id")
  name            String
  description     String?
  price           Decimal         @db.Decimal(10, 2)
  salePrice       Decimal?        @map("sale_price") @db.Decimal(10, 2)
  sku             String          @unique
  images          String[]        @default([])
  attributes      Json            @default("{}")
  isActive        Boolean         @default(true) @map("is_active")
  stockQuantity   Int             @default(0) @map("stock_quantity")
  tags            String[]        @default([])
  rating          Decimal?        @db.Decimal(2, 1)
  reviewCount     Int             @default(0) @map("review_count")
  taxAffectation  TaxAffectation  @default(gravado) @map("tax_affectation")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  variants              ProductVariant[]
  inventoryTransactions InventoryTransaction[]
  stockAlerts           StockAlert[]
  reviews               ProductReview[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id             String          @id @default(uuid())
  productId      String          @map("product_id")
  name           String
  price          Decimal         @db.Decimal(10, 2)
  sku            String          @unique
  stockQuantity  Int             @default(0) @map("stock_quantity")
  attributes     Json            @default("{}")
  isActive       Boolean         @default(true) @map("is_active")
  // Nullable: null means "inherit taxAffectation from parent Product".
  // Effective affectation = variant.taxAffectation ?? product.taxAffectation (resolved by backend).
  taxAffectation TaxAffectation? @map("tax_affectation")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model InventoryTransaction {
  id        String                   @id @default(uuid())
  productId String                   @map("product_id")
  type      InventoryTransactionType
  quantity  Int
  reference String?
  notes     String?
  createdAt DateTime                 @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("inventory_transactions")
}

model StockAlert {
  id           String         @id @default(uuid())
  productId    String         @map("product_id")
  type         StockAlertType
  threshold    Int
  currentStock Int            @map("current_stock")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("stock_alerts")
}

// Inbox for idempotent processing of consumed domain events (e.g. order.created).
// A row's presence means the event was already applied; reprocessing is a no-op.
model InboxEvent {
  eventId     String   @id @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("inbox_events")
}

enum InventoryTransactionType {
  purchase
  sale
  return
  adjustment
  transfer
}

enum StockAlertType {
  low_stock
  out_of_stock
  overstock
}

model ProductReview {
  id           String        @id @default(uuid())
  productId    String        @map("product_id")
  userId       String        @map("user_id")
  rating       Int
  title        String?
  comment      String?
  // @deprecated: superseded by `status` (ReviewStatus state machine). Kept for backward
  // compatibility during rolling deploy. Do NOT use in new code — read `status` instead.
  isApproved   Boolean       @default(false) @map("is_approved")
  isVerified   Boolean       @default(false) @map("is_verified")
  helpfulCount Int           @default(0) @map("helpful_count")
  // State machine: pending → approved | rejected.
  // Moderation use case transitions the status and emits domain event.
  status       ReviewStatus  @default(pending)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  photos  ReviewPhoto[]
  votes   ReviewVote[]

  @@unique([productId, userId], map: "product_reviews_product_id_user_id_key")
  // Composite index covers the hot query: "approved reviews for product X"
  // (WHERE product_id = ? AND status = 'approved').
  // Leading column product_id also covers plain product_id lookups.
  // The prior @@index([productId]) from the @@unique constraint is intentionally
  // NOT duplicated here — this composite replaces its role and adds status filtering.
  @@index([productId, status])
  @@index([userId])
  @@map("product_reviews")
}

enum ReviewStatus {
  pending
  approved
  rejected
}

// Tipo de afectación IGV SUNAT (Catálogo 07).
// Usado por invoicing-service para determinar el tratamiento fiscal de cada línea.
enum TaxAffectation {
  gravado    @map("gravado")
  exonerado  @map("exonerado")
  inafecto   @map("inafecto")
}

model ReviewPhoto {
  id        String        @id @default(uuid())
  reviewId  String        @map("review_id")
  imageUrl  String        @map("image_url")
  caption   String?
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photos")
}

model ReviewVote {
  id        String        @id @default(uuid())
  reviewId  String        @map("review_id")
  userId    String        @map("user_id")
  isHelpful Boolean       @map("is_helpful")
  createdAt DateTime      @default(now()) @map("created_at")

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
  @@map("review_votes")
}
