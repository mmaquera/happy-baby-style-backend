{
  "name": "product-service",
  "projectType": "application",
  "sourceRoot": "apps/product-service/src",
  "implicitDependencies": ["logging", "prisma", "shared-kernel"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": {
        "command": "rm -rf apps/product-service/dist && tsc -p apps/product-service/tsconfig.json"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/product-service/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node-dev --respawn --transpile-only apps/product-service/src/index.ts",
        "env": {
          "TS_NODE_PROJECT": "apps/product-service/tsconfig.json"
        }
      }
    }
  }
}
