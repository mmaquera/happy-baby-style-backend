{
  "name": "happy-baby-style-admin-backend",
  "version": "1.0.0",
  "description": "Backend API for Happy Baby Style Admin Panel",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build --base=origin/main",
    "type-check": "nx run-many --target=type-check --all",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "eslint apps libs --fix",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\"",
    "test": "nx run-many --target=test --all",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "gateway:serve": "nx serve gateway",
    "gateway:build": "nx build gateway",
    "rover:compose": "rover supergraph compose --config supergraph.yaml --output supergraph.graphql"
  },
  "dependencies": {
    "@apollo/gateway": "^2.14.0",
    "@apollo/server": "^4.11.2",
    "@apollo/subgraph": "^2.14.0",
    "@hbs/auth": "workspace:*",
    "@hbs/logging": "workspace:*",
    "@hbs/prisma": "workspace:*",
    "@hbs/shared-kernel": "workspace:*",
    "@prisma/client": "^6.13.0",
    "@types/nodemailer": "^7.0.2",
    "apollo-upload-client": "^18.0.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-slow-down": "^3.0.0",
    "express-validator": "^7.0.1",
    "graphql": "^16.8.1",
    "graphql-tag": "^2.12.6",
    "graphql-upload": "^17.0.0",
    "graphql-upload-cjs": "^15.0.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "winston-transport": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-resolvers": "^4.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/graphql-upload": "^17.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "@types/winston": "^2.4.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "nx": "22.7.3",
    "prettier": "^3.8.3",
    "prisma": "^6.13.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.59.4"
  }
}