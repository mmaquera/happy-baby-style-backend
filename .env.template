# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://localhost:3007
RESET_PASSWORD_URL=http://localhost:3007 

# Prisma Database Configuration
# Example: postgresql://user:password@host:5432/db_name
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# JWT Configuration (for authentication)
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# OAuth General Configuration
OAUTH_STATE_SECRET=
SESSION_SECRET=

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=true
LOG_ENABLE_DAILY_ROTATE=true
LOG_DIRECTORY=./logs
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
LOG_FORMAT=json
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_TRACE_ID=true
LOG_INCLUDE_REQUEST_ID=true
LOG_INCLUDE_USER_ID=true
LOG_ENABLE_ERROR_STACK=true
LOG_ENABLE_PERFORMANCE=true

# Docker Local Development
# Usadas por docker-compose.yml para levantar Postgres y Redis localmente.
# DATABASE_URL y REDIS_URL se sobreescriben automáticamente en el servicio
# legacy-api para apuntar a los contenedores, no a RDS.
DOCKER_DB_NAME=happy_baby_style
DOCKER_DB_USER=postgres
DOCKER_DB_PASSWORD=          # REQUERIDO — pon cualquier contraseña para dev
DOCKER_DB_PORT=5432
REDIS_PORT=6379
GATEWAY_PORT=4000
CATEGORY_SERVICE_PORT=3002
PRODUCT_SERVICE_PORT=3003
MEDIA_SERVICE_PORT=3004
ORDER_SERVICE_PORT=3005
USER_SERVICE_PORT=3006

# Rate Limiting Configuration
# Set to 'false' to disable rate limiting in development
ENABLE_RATE_LIMIT=false
# Requests per 15 min per IP for general endpoints (gateway)
RATE_LIMIT_GENERAL=300
# Requests per 15 min per IP for auth mutations (gateway)
RATE_LIMIT_AUTH=10

# ── Trust Proxy ─────────────────────────────────────────────────────────────
# Controls how Express resolves the real client IP from X-Forwarded-For.
#   'loopback'  → safe default for docker-compose; trusts 127.0.0.1 / ::1 only.
#   1           → trust exactly 1 upstream proxy (e.g. nginx or AWS ALB in prod).
#   false       → no proxy; use raw socket IP.
# WARNING: NEVER set to 'true' in production — any client can spoof X-Forwarded-For
#          and bypass rate limiting or inject a false IP into audit logs.
TRUST_PROXY=loopback

# ── Account Lockout (user-service) ──────────────────────────────────────────
# How many consecutive failed login attempts before the account is locked.
MAX_LOGIN_ATTEMPTS=5
# How long (in seconds) the account stays locked after MAX_LOGIN_ATTEMPTS exceeded.
LOCKOUT_DURATION=900

# ── MFA Encryption Key (user-service) ───────────────────────────────────────
# AES-256-GCM key used to encrypt TOTP secrets at rest.
# REQUIRED when MFA is enabled. Must be 32 bytes (256-bit), base64-encoded.
# NEVER commit a real value here. Store in your secret manager (Vault / AWS SSM / etc.).
# Generate: openssl rand -base64 32
MFA_ENC_KEY=                 # !!SECRET — do NOT commit a real value!!

# ── Email Verification URLs (user-service) ───────────────────────────────────
# Base URL the front-end will use to build the email verification deep link.
# The use case appends ?token=<jwt> to this URL.
VERIFY_EMAIL_URL=http://localhost:3000/verify-email

STORAGE_BASE_URL=http://localhost:3001

# ── Object Storage — MinIO / S3 (media-service) ──────────────────────────────
# STORAGE_DRIVER=local  → archivos locales en /app/uploads (default; no requiere MinIO).
# STORAGE_DRIVER=s3     → S3-compatible via MinIO u otro proveedor; las vars S3_* son
#                         REQUERIDAS en ese modo.
#
# Para dev con MinIO:
#   1. Levantar MinIO primero: docker compose up minio minio-init -d
#   2. Cambiar STORAGE_DRIVER a 's3' y copiar las credenciales de abajo.
#   3. El bucket 'happy-baby-media' se crea automáticamente por minio-init.
#
# Para producción: reemplazar S3_ENDPOINT, S3_ACCESS_KEY_ID y S3_SECRET_ACCESS_KEY
#   con los valores de tu proveedor (AWS S3, Cloudflare R2, etc.).

STORAGE_DRIVER=local

# Puerto de la API S3 de MinIO (dev)
MINIO_PORT=9000
# Puerto de la consola web de MinIO (dev) — http://localhost:9001
MINIO_CONSOLE_PORT=9001
# Credenciales de MinIO (dev only — NUNCA usar estos valores en producción)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin   # SECRET en prod — usar secret manager

# Configuración S3 para media-service (aplicada cuando STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=happy-baby-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin      # Mismo que MINIO_ROOT_USER en dev
S3_SECRET_ACCESS_KEY=minioadmin  # Mismo que MINIO_ROOT_PASSWORD en dev — SECRET en prod
# URL pública desde la que el cliente descarga archivos (puede ser CDN en prod)
S3_PUBLIC_URL=http://localhost:9000/happy-baby-media

SMTP_HOST=mail.tudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@tudominio.com
SMTP_PASSWORD=tu_password_del_email
SMTP_FROM=noreply@tudominio.com
FRONTEND_URL=https://tudominio.com

# ── RBAC / Record Rules ────────────────────────────────────────────────
# Stream que publica cambios de reglas de acceso (permisos/grupos/roles).
# Consumido por los 5 subgraphs para invalidar su caché local de RBAC.
# Ver: libs/authz y apps/<service>/src/infrastructure/messaging/RbacConsumer.ts
RBAC_STREAM_NAME=stream:record-rules-updated
RBAC_STREAM_MAXLEN=10000
RBAC_CACHE_TTL_MS=300000
RBAC_AUTOCLAIM_IDLE_MS=60000