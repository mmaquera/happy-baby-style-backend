FROM node:22-alpine AS builder

WORKDIR /workspace

RUN npm install -g pnpm@latest

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml nx.json tsconfig.base.json ./
COPY libs/prisma/package.json libs/prisma/
COPY libs/logging/package.json libs/logging/
COPY libs/shared-kernel/package.json libs/shared-kernel/
COPY libs/auth/package.json libs/auth/
COPY apps/media-service/package.json apps/media-service/

COPY libs/prisma/prisma ./libs/prisma/prisma

RUN pnpm install --frozen-lockfile

COPY libs/ libs/
COPY apps/media-service/ apps/media-service/

RUN pnpm exec nx run prisma:build
RUN pnpm exec nx run logging:build
RUN pnpm exec nx run shared-kernel:build
RUN pnpm exec nx run auth:build
RUN pnpm exec nx run media-service:build

FROM node:22-alpine AS runner

WORKDIR /workspace

RUN npm install -g pnpm@latest

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY libs/prisma/package.json libs/prisma/
COPY libs/logging/package.json libs/logging/
COPY libs/shared-kernel/package.json libs/shared-kernel/
COPY libs/auth/package.json libs/auth/
COPY apps/media-service/package.json apps/media-service/

COPY libs/prisma/prisma ./libs/prisma/prisma

RUN pnpm install --frozen-lockfile --prod

COPY --from=builder /workspace/libs/prisma/dist ./libs/prisma/dist
COPY --from=builder /workspace/libs/logging/dist ./libs/logging/dist
COPY --from=builder /workspace/libs/shared-kernel/dist ./libs/shared-kernel/dist
COPY --from=builder /workspace/libs/auth/dist ./libs/auth/dist
COPY --from=builder /workspace/apps/media-service/dist ./apps/media-service/dist

EXPOSE 3004

CMD ["node", "apps/media-service/dist/src/index.js"]
