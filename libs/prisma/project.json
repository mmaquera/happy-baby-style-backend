{
  "name": "prisma",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/prisma/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "rm -rf libs/prisma/dist && tsc -p libs/prisma/tsconfig.json"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/prisma/tsconfig.json"
      }
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma generate --schema=libs/prisma/schema.prisma"
      }
    },
    "prisma-migrate-status": {
      "executor": "nx:run-commands",
      "options": {
        // NOTE (tracking item 7.13): This target runs against libs/prisma/schema.prisma,
        // which is the canonical shared schema used by the @hbs/prisma singleton client.
        // It does NOT reflect the per-service migration histories under
        // apps/<service>/prisma/migrations/. Use `nx run <service>:migrate-status`
        // to inspect the migration state of a specific service database.
        "command": "prisma migrate status --schema=libs/prisma/schema.prisma"
      }
    },
    "lint": {}
  }
}
