{
  "name": "authz",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/authz/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "rm -rf libs/authz/dist && tsc -p libs/authz/tsconfig.json"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/authz/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config libs/authz/jest.config.js"
      }
    },
    "lint": {}
  },
  "implicitDependencies": ["auth"]
}
